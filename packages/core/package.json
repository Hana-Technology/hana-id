{
  "name": "@hana-id/core",
  "version": "0.0.0",
  "description": "Pure TypeScript core of Hana ID (no DOM): byte layouts, CKD, derivation v1, signers, decoders, token checks and protocol message schemas.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./derivation": "./src/derivation.ts"
  },
  "scripts": {
    "test": "vitest run",
    "gen-vectors": "node scripts/gen-layout-vectors.mjs && node scripts/gen-derivation-vectors.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "viem": "2.57.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@stellar/stellar-base": "15.0.0"
  }
}
