{
  "name": "@hana-id/email",
  "version": "0.0.0",
  "private": true,
  "description": "Email login identity rules: address normalization, the frozen e1. sub derivation, the Google-hosted rule and the pinned disposable-domain list. Runs in Workers and browsers (Web Crypto only).",
  "type": "module",
  "sideEffects": false,
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "test": "vitest run && vitest run -c vitest.workerd.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "gen-vectors": "node scripts/gen-vectors.mjs",
    "update-disposable": "node scripts/update-disposable-domains.mjs",
    "update-unicode-age": "node scripts/update-unicode-age.mjs"
  },
  "dependencies": { "tr46": "7.0.0" },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
