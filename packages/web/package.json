{
  "name": "@hana-id/web",
  "version": "0.0.0",
  "description": "Hana ID browser SDK (createHana partner client) and the Hana pages (vault, login, callback, approval, export), built per env.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./stellar-wallets-kit": "./src/stellar-wallets-kit.ts"
  },
  "scripts": {
    "gen:envs": "tsx scripts/gen-envs.ts",
    "build": "tsx scripts/gen-envs.ts",
    "test": "tsx scripts/gen-envs.ts && vitest run",
    "typecheck": "tsx scripts/gen-envs.ts && tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@hana-id/core": "workspace:*"
  },
  "devDependencies": {
    "@hana-id/env": "workspace:*",
    "@types/node": "22.20.5",
    "happy-dom": "21.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
