<style>:root{color-scheme:light dark;supported-color-schemes:light dark}body{margin:0!important;padding:0!important;width:100%!important}a[x-apple-data-detectors],.hm-host a,.hm-code a{color:inherit!important;text-decoration:none!important;font-size:inherit!important;font-family:inherit!important;font-weight:inherit!important;line-height:inherit!important}@media (max-width:480px){.hm-pad{padding:24px 20px 20px!important}.hm-outer{padding:16px 8px!important}.hm-code{font-size:30px!important;letter-spacing:6px!important;margin-right:-6px!important}}@media (prefers-color-scheme:dark){.hm-page{background-color:#0d0229!important}.hm-card{background-color:#170b36!important;border-color:#2c1b57!important}.hm-ink{color:#f1edfc!important}.hm-ink2{color:#d4c5f9!important}.hm-muted{color:#a99cc9!important}.hm-accent{color:#bba8f6!important}.hm-line{border-color:#2c1b57!important}.hm-codebox{background-color:#1f133f!important;border-color:#4a3683!important}.hm-info{background-color:#2b1c5e!important;border-color:#bba8f6!important;color:#f1edfc!important}.hm-warn{background-color:#33290f!important;border-color:#6b551d!important;color:#f0c565!important}.hm-btn{background-color:#bba8f6!important}.hm-btn-a{color:#0d0229!important}}[data-ogsc] .hm-page{background-color:#0d0229!important}[data-ogsc] .hm-card{background-color:#170b36!important;border-color:#2c1b57!important}[data-ogsc] .hm-ink{color:#f1edfc!important}[data-ogsc] .hm-ink2{color:#d4c5f9!important}[data-ogsc] .hm-muted{color:#a99cc9!important}[data-ogsc] .hm-accent{color:#bba8f6!important}[data-ogsc] .hm-line{border-color:#2c1b57!important}[data-ogsc] .hm-codebox{background-color:#1f133f!important;border-color:#4a3683!important}[data-ogsc] .hm-info{background-color:#2b1c5e!important;border-color:#bba8f6!important;color:#f1edfc!important}[data-ogsc] .hm-warn{background-color:#33290f!important;border-color:#6b551d!important;color:#f0c565!important}[data-ogsc] .hm-btn{background-color:#bba8f6!important}[data-ogsc] .hm-btn-a{color:#0d0229!important}</style>
