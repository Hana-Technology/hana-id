{
  "name": "@hana-id/web",
  "version": "0.4.0",
  "description": "Hana ID browser SDK: the createHana partner client (EIP-1193 provider, Stellar signer, Stellar Wallets Kit module). In the workspace it also builds the Hana pages (vault, login, callback, approval, export) per env; those are never packed.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hana-Technology/hana-id.git",
    "directory": "packages/web"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./stellar-wallets-kit": "./src/stellar-wallets-kit.ts"
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/lib/index.d.ts",
        "import": "./dist/lib/index.js"
      },
      "./stellar-wallets-kit": {
        "types": "./dist/lib/stellar-wallets-kit.d.ts",
        "import": "./dist/lib/stellar-wallets-kit.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/lib/index.js",
    "types": "./dist/lib/index.d.ts"
  },
  "scripts": {
    "build:lib": "tsx scripts/gen-envs.ts --package && tsx ../../scripts/sdk-build.ts",
    "prepack": "pnpm run build:lib",
    "gen:envs": "tsx scripts/gen-envs.ts",
    "build": "tsx scripts/gen-envs.ts && tsx scripts/build-vault.ts && tsx scripts/build-auth-pages.ts",
    "build:auth": "tsx scripts/build-auth-pages.ts",
    "build:vault": "tsx scripts/build-vault.ts",
    "test": "tsx scripts/gen-envs.ts && vitest run",
    "typecheck": "tsx scripts/gen-envs.ts && tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@hana-id/core": "workspace:^"
  },
  "devDependencies": {
    "@hana-id/brand": "workspace:*",
    "@hana-id/env": "workspace:*",
    "@noble/curves": "1.9.7",
    "@scure/base": "1.2.6",
    "@stellar/stellar-base": "15.0.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
