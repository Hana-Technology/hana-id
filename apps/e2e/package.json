{
  "name": "@hana-id/e2e",
  "version": "0.0.0",
  "description": "Playwright suite for the Hana pages and @hana-id/web against local builds, a mocked Hana API, NEAR RPC and MPC, and an OIDC stub for Google.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx src/build.ts",
    "serve": "tsx src/server/main.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit firefox",
    "test": "vitest run",
    "typecheck": "tsx ../../packages/web/scripts/gen-envs.ts && tsc --noEmit"
  },
  "dependencies": {
    "@hana-id/core": "workspace:*",
    "@hana-id/web": "workspace:*"
  },
  "devDependencies": {
    "@noble/curves": "1.9.7",
    "@playwright/test": "1.64.1",
    "@scure/base": "1.2.6",
    "@stellar/stellar-base": "15.0.0",
    "@types/node": "22.20.5",
    "@wagmi/core": "3.6.5",
    "esbuild": "0.28.2",
    "jose": "6.2.13",
    "swk1": "npm:@creit.tech/stellar-wallets-kit@1.9.5",
    "swk2": "npm:@creit.tech/stellar-wallets-kit@2.7.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "viem": "2.57.7",
    "vitest": "4.1.12"
  }
}
