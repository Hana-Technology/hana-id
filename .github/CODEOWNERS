# Code owners (docs/decisions.md D58, D100; security sweep OPER-1, OPER-3). These paths decide every user's address or
# key, every environment's accounts and pinned keys, handle tokens and keys, or decide what the secret scan and CI
# enforce: a change to any of them needs a code owner's review. Branch protection on `develop` and `main` must have
# "Require review from Code Owners" on (and the author's own approval not counting) for this to block a merge.
#
# The LAST matching line wins and replaces the earlier ones, so the broad paths come first and each specific path
# below lists all of its owners.
#
# Two owners (decided 2026-10-29, security sweep owner answers): @tzechuen and @mj-hana. With "Require review from
# Code Owners" on, a change by one needs the other's approval.

# Code that handles tokens, keys and the vault: the API, the browser SDK and vault, core crypto and policy, the
# watchdog, and the operator scripts (access-key method lists, secret files, deploys).
/apps/api/src/                  @tzechuen @mj-hana
/apps/watchdog/src/             @tzechuen @mj-hana
/packages/web/src/              @tzechuen @mj-hana
/packages/core/src/             @tzechuen @mj-hana
/scripts/                       @tzechuen @mj-hana
# The ID-token and Access-JWT checks (moved out of /apps/api/src/ in batch C step C2).
/packages/oidc/src/             @tzechuen @mj-hana

# Dependencies: a changed lockfile can swap any crypto library.
/pnpm-lock.yaml                 @tzechuen @mj-hana
/pnpm-workspace.yaml            @tzechuen @mj-hana
/contracts/**/Cargo.lock        @tzechuen @mj-hana

# Derivation v1 and its golden vectors: a change here changes every address (frozen after the address freeze).
/packages/core/src/derivation*  @tzechuen @mj-hana
/packages/core/test/vectors/    @tzechuen @mj-hana

# The signer contract: token checks, the registry, sessions and the MPC request.
/contracts/hana-signer/         @tzechuen @mj-hana

# The manifest schema: account names, origins and the rules for the pinned CKD key every bundle is built with.
/packages/env/src/              @tzechuen @mj-hana

# Batch C: the console's nonce and digest layouts, origin rules and RPC types; the usage ledger's roles, grants and
# functions; the console database (sessions, invites, audit triggers).
/packages/console-core/         @tzechuen @mj-hana
/apps/api/migrations-usage/     @tzechuen @mj-hana
/apps/console/migrations/       @tzechuen @mj-hana

# The manifests themselves: account names, RPCs and the pinned CKD network key (`ckdNetworkKey`) every bundle trusts.
/envs/                          @tzechuen @mj-hana

# Secret scanning, hooks and CI (what blocks a leaked key or an untested change).
/.gitleaks.toml                 @tzechuen @mj-hana
/.githooks/                     @tzechuen @mj-hana
/.github/                       @tzechuen @mj-hana
