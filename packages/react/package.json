{
  "name": "@hana-id/react",
  "version": "0.0.0",
  "description": "React bindings for Hana ID over @hana-id/web: HanaProvider, useHana, useWallet.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "pnpm --filter @hana-id/web gen:envs && vitest run",
    "typecheck": "pnpm --filter @hana-id/web gen:envs && tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@hana-id/web": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
