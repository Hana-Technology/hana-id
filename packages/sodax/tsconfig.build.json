{
  // The published build (`pnpm build:lib`): ESM + .d.ts + source maps into dist/. @hana-id/web and @hana-id/core
  // resolve to their built declarations, so their sources stay out of this program. Workspace code keeps importing
  // src/ through `exports`; pnpm pack swaps in `publishConfig.exports`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@hana-id/core": ["../core/dist/index.d.ts"],
      "@hana-id/core/*": ["../core/dist/*.d.ts", "../core/dist/*/index.d.ts"],
      "@hana-id/web": ["../web/dist/lib/index.d.ts"],
      "@hana-id/web/*": ["../web/dist/lib/*.d.ts"]
    }
  },
  "include": ["src"]
}
