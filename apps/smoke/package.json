{
  "name": "@hana-id/smoke",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:envs": "tsx ../../packages/web/scripts/gen-envs.ts",
    "dev": "tsx ../../packages/web/scripts/gen-envs.ts && vite",
    "build": "tsx ../../packages/web/scripts/gen-envs.ts && vite build",
    "test": "vitest run",
    "typecheck": "tsx scripts/ensure-web-envs.ts && tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@hana-id/core": "workspace:*",
    "@hana-id/web": "workspace:*",
    "@stellar/stellar-base": "15.0.0"
  },
  "devDependencies": {
    "@hana-id/env": "workspace:*",
    "@noble/curves": "1.9.7",
    "@scure/base": "1.2.6",
    "@types/node": "^22.0.0",
    "happy-dom": "21.0.3",
    "tsx": "4.23.15",
    "typescript": "^5.7.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
