{
  // The published build (`pnpm build`): ESM + .d.ts + source maps (sources inlined, paths relative) into dist/.
  // Workspace code keeps importing src/ through `exports`; pnpm pack swaps in `publishConfig.exports` (dist/).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"]
}
