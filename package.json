{
  "name": "hana-id",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "pack:check": "pnpm --filter @hana-id/scripts run pack:check",
    "prepare": "git config core.hooksPath .githooks",
    "secrets:scan": "gitleaks git --no-banner --redact --config .gitleaks.toml",
    "verify": "node scripts/verify.mjs",
    "verify:install-hook": "node scripts/verify-hook.mjs install"
  }
}
