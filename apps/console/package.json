{
  "name": "@hana-id/console",
  "version": "0.0.0",
  "private": true,
  "description": "The partner console Worker (docs/batch-c-spec.md): CONSOLE_DB and its migrations, host dispatch, headers and CSRF, StaffRpc, invites and owner grants, the hourly cron. Batch C7: backend only, no public route; sign-in and the SPA come in C9.",
  "type": "module",
  "scripts": {
    "gen": "tsx scripts/gen-wrangler.ts",
    "deploy": "wrangler deploy",
    "test": "vitest run && vitest run -c vitest.scripts.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@hana-id/console-core": "workspace:*",
    "@hana-id/oidc": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@hana-id/env": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.0",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
