{
  "name": "@hana-id/core",
  "version": "0.2.0",
  "description": "Pure TypeScript core of Hana ID (no DOM): byte layouts, CKD, derivation v1, signers, decoders, token checks and protocol message schemas.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hana-Technology/hana-id.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./derivation": "./src/derivation.ts",
    "./identity": "./src/identity.ts",
    "./wallet-record": "./src/wallet-record.ts",
    "./signers/stellar": "./src/signers/stellar.ts",
    "./decode": "./src/decode/index.ts",
    "./policy": "./src/policy/index.ts",
    "./mainnet-demo": "./src/mainnet-demo.ts",
    "./demo-config": "./src/demo-config.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./derivation": {
        "types": "./dist/derivation.d.ts",
        "import": "./dist/derivation.js"
      },
      "./identity": {
        "types": "./dist/identity.d.ts",
        "import": "./dist/identity.js"
      },
      "./wallet-record": {
        "types": "./dist/wallet-record.d.ts",
        "import": "./dist/wallet-record.js"
      },
      "./signers/stellar": {
        "types": "./dist/signers/stellar.d.ts",
        "import": "./dist/signers/stellar.js"
      },
      "./decode": {
        "types": "./dist/decode/index.d.ts",
        "import": "./dist/decode/index.js"
      },
      "./policy": {
        "types": "./dist/policy/index.d.ts",
        "import": "./dist/policy/index.js"
      },
      "./mainnet-demo": {
        "types": "./dist/mainnet-demo.d.ts",
        "import": "./dist/mainnet-demo.js"
      },
      "./demo-config": {
        "types": "./dist/demo-config.d.ts",
        "import": "./dist/demo-config.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build:lib": "tsx ../../scripts/sdk-build.ts",
    "prepack": "pnpm run build:lib",
    "test": "vitest run",
    "gen-vectors": "node scripts/gen-layout-vectors.mjs && node scripts/gen-derivation-vectors.mjs && node scripts/gen-identity-vectors.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@stellar/stellar-base": "15.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "viem": "2.57.7",
    "vitest": "4.1.12"
  }
}
