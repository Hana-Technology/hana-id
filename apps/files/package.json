{
  "name": "@hana-id/files",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "The files Worker (docs/batch-c-spec.md, batch C11): serves only GET /logos/<app_id>/<sha256>.png from the LOGOS R2 bucket, re-checked and sandboxed. No secret, D1 or Hyperdrive.",
  "type": "module",
  "scripts": {
    "gen": "tsx scripts/gen-wrangler.ts",
    "deploy": "tsx ../../packages/env/src/stamped-deploy.ts",
    "test": "vitest run && vitest run -c vitest.scripts.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts"
  },
  "dependencies": {
    "@hana-id/brand": "workspace:*",
    "@hana-id/env": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.0",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
