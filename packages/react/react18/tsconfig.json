{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "@testing-library/react": [
        "./node_modules/@testing-library/react"
      ]
    }
  },
  "include": [
    "../src",
    "../test",
    "test",
    "vitest.config.ts"
  ]
}
