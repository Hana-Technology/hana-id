exports[`notices: the designed HTML part > the link notice: one button to the cancel page on authOrigin, the URL also as text; the text part as before > text 1`] = `
"This email is being linked to a Hana wallet in “Sodax Demo” together with a Google sign-in. The link takes effect after a waiting period (24 hours on Hana's live network), and can be cancelled until then.

Not you? https://hana-id-auth-sandbox-dev.example.workers.dev/link/cancel
"
`;

exports[`notices: the designed HTML part > unlock and confirm: one button to their page with the token in the fragment > confirm text 1`] = `
"Hana stopped sending sign-in codes to this email after a bounce or a spam report. To receive them again, open this link. It works once, within 24 hours.

https://hana-id-auth-sandbox-dev.example.workers.dev/email/confirm#tok_def

Didn’t ask Hana support for this? Ignore this mail: nothing changes.
"
`;

exports[`notices: the designed HTML part > unlock and confirm: one button to their page with the token in the fragment > unlock text 1`] = `
"Hana support unlocked sign-in with this email, as you asked. To sign in, open this link in the browser where you use the app. It works once, within 24 hours.

https://hana-id-auth-sandbox-dev.example.workers.dev/email/unlock#tok_abc

Didn’t ask Hana support for this? Ignore this mail: nothing changes.
"
`;
