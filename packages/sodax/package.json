{
  "name": "@hana-id/sodax",
  "version": "0.3.1",
  "description": "Optional Sodax wallet-provider adapters (IStellarWalletProvider, IEvmWalletProvider) over @hana-id/web.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hana-Technology/hana-id.git",
    "directory": "packages/sodax"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build:lib": "tsx ../../scripts/sdk-build.ts",
    "prepack": "pnpm run build:lib",
    "test": "tsx ../web/scripts/gen-envs.ts && vitest run",
    "typecheck": "tsx ../web/scripts/gen-envs.ts && tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@hana-id/core": "workspace:^",
    "@hana-id/web": "workspace:^"
  },
  "peerDependencies": {
    "@sodax/types": "^2.2.0"
  },
  "devDependencies": {
    "@sodax/types": "2.2.0",
    "@stellar/stellar-base": "15.0.0",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
